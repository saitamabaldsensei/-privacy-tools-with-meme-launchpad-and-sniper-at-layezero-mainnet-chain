pragma solidity ^0.8.24;

import "@openzeppelin/contracts/token/ERC20/ERC20.sol";
import "@openzeppelin/contracts/access/Ownable.sol";
import "@openzeppelin/contracts/utils/ReentrancyGuard.sol";

contract ShadowLaunch is Ownable, ReentrancyGuard {

    struct Launch {
        address creator;
        address token;
        bytes32 privateCommitment;
        uint256 launchTime;
        bool active;
    }

    mapping(uint256 => Launch) public launches;
    mapping(address => bool) public verifiedTokens;

    uint256 public launchCount;
    uint256 public launchFee = 0.001 ether;

    event TokenLaunched(
        uint256 indexed id,
        address indexed creator,
        address token
    );

    event PrivacyCommitted(
        uint256 indexed id,
        bytes32 commitment
    );

    constructor()
        Ownable(msg.sender)
    {}

    // Create meme token
    function createMeme(
        string memory name,
        string memory symbol,
        uint256 supply,
        bytes32 commitment
    ) external payable nonReentrant {

        require(msg.value >= launchFee, "Insufficient fee");
        require(supply > 0, "Invalid supply");

        MemeToken token = new MemeToken(
            name,
            symbol,
            supply,
            msg.sender
        );

        launchCount++;

        launches[launchCount] = Launch({
            creator: msg.sender,
            token: address(token),
            privateCommitment: commitment,
            launchTime: block.timestamp,
            active: true
        });

        verifiedTokens[address(token)] = true;

        emit TokenLaunched(
            launchCount,
            msg.sender,
            address(token)
        );

        emit PrivacyCommitted(
            launchCount,
            commitment
        );
    }

    // Register private metadata commitment
    function updatePrivacy(
        uint256 id,
        bytes32 commitment
    ) external {

        require(
            launches[id].creator == msg.sender,
            "Not creator"
        );

        launches[id].privateCommitment = commitment;

        emit PrivacyCommitted(id, commitment);
    }

    // AI sniper signal verification
    function verifyToken(
        address token
    ) external onlyOwner {

        verifiedTokens[token] = true;
    }

    // Launch information
    function getLaunch(
        uint256 id
    ) external view returns (
        address creator,
        address token,
        uint256 launchTime,
        bool active
    ) {
        Launch memory item = launches[id];

        return (
            item.creator,
            item.token,
            item.launchTime,
            item.active
        );
    }

    function withdrawFees() external onlyOwner {
        payable(owner()).transfer(address(this).balance);
    }
}

contract MemeToken is ERC20 {

    constructor(
        string memory name,
        string memory symbol,
        uint256 supply,
        address creator
    ) ERC20(name, symbol) {

        _mint(creator, supply * 10 ** decimals());
    }
}
